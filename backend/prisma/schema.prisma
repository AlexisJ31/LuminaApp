// Schema de Prisma para LuminaApp (Finanzas Personales)
// Cumple con el Plan Maestro de Ingesta, Arquitectura y Reglas de Oro de Ingenieria

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum AccountType {
  DEBIT
  CREDIT
  CASH
  SAVINGS
  INVESTMENT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  UNREVIEWED
  REVIEWED
  REJECTED
}

enum TransactionSource {
  MANUAL
  WEBHOOK_N8N
  YAPPY_PUSH
  WHATSAPP_BOT
  EMAIL_PARSER
  IMPORT
  OPEN_BANKING
}

enum BudgetPeriod {
  MONTHLY
  WEEKLY
  YEARLY
}

enum ConnectionType {
  WEBHOOK
  OPEN_BANKING
  EMAIL_PARSER
  MANUAL_IMPORT
}

enum ConnectionStatus {
  ACTIVE
  PAUSED
  REVOKED
}

enum RawEventStatus {
  PENDING
  PROCESSED
  DUPLICATE
  FAILED
}

enum ReviewReason {
  LOW_CONFIDENCE
  POSSIBLE_DUPLICATE
  NEW_MERCHANT
  MANUAL_FLAG
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  MERGE
}

// ------------------------------------------------------
// Modelos Relacionales
// ------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  currency     String        @default("USD")
  timezone     String        @default("America/Panama")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  sourceConnections SourceConnection[]
  rawEvents         RawEvent[]
  reviewItems       ReviewItem[]
  merchantAliases   MerchantAlias[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Account {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType @default(DEBIT)
  
  // Regla de Oro: El Dogma de la Moneda (enteros en centavos)
  balanceInCents Int         @default(0)
  
  color          String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactions   Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id           String          @id @default(uuid())
  userId       String?         // Nullable para categorias globales por defecto
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  icon         String          @default("tag")
  color        String          @default("#3B82F6")
  type         TransactionType @default(EXPENSE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  transactions    Transaction[]
  budgets         Budget[]
  merchantAliases MerchantAlias[]

  @@index([userId])
  @@map("categories")
}

model SourceConnection {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  type            ConnectionType   @default(WEBHOOK)
  status          ConnectionStatus @default(ACTIVE)
  apiKeyHash      String?          @unique
  encryptedSecret String?
  lastSyncAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rawEvents  RawEvent[]
  syncCursor SyncCursor?

  @@index([userId])
  @@map("source_connections")
}

model RawEvent {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId   String?
  connection     SourceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  source         TransactionSource @default(WEBHOOK_N8N)
  idempotencyKey String?           @unique
  payloadHash    String
  payloadJson    String            // Serialized JSON del evento crudo
  status         RawEventStatus    @default(PENDING)
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())

  transactions Transaction[]

  @@index([userId, createdAt])
  @@index([payloadHash])
  @@map("raw_events")
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rawEventId      String?
  rawEvent        RawEvent?         @relation(fields: [rawEventId], references: [id], onDelete: SetNull)
  
  // Regla de Oro: El Dogma de la Moneda (enteros en centavos)
  amountInCents   Int
  
  type            TransactionType   @default(EXPENSE)
  status          TransactionStatus @default(UNREVIEWED)
  source          TransactionSource @default(MANUAL)
  
  description     String
  merchantName    String?
  confidenceScore Float             @default(1.0)
  notes           String?
  date            DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  reviewItem ReviewItem?

  @@index([userId, date])
  @@index([status])
  @@index([userId, amountInCents, date])
  @@map("transactions")
}

model ReviewItem {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId       String       @unique
  transaction         Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  confidenceScore     Float
  suggestedCategoryId String?
  reason              ReviewReason @default(LOW_CONFIDENCE)
  resolvedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([userId, resolvedAt])
  @@map("review_items")
}

model MerchantAlias {
  id                String    @id @default(uuid())
  userId            String?   // Nullable para catalogo general de Panama
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawPattern        String
  normalizedName    String
  defaultCategoryId String?
  defaultCategory   Category? @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  confidence        Float     @default(1.0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, rawPattern])
  @@map("merchant_aliases")
}

model SyncCursor {
  id           String           @id @default(uuid())
  connectionId String           @unique
  connection   SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  cursorValue  String
  lastSyncAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("sync_cursors")
}

model Budget {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  // Regla de Oro: El Dogma de la Moneda
  limitInCents Int
  
  period       BudgetPeriod @default(MONTHLY)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([userId, categoryId, period])
  @@map("budgets")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     AuditAction
  metadata   String?     // Serialized JSON
  createdAt  DateTime    @default(now())

  @@index([userId, createdAt])
  @@map("audit_logs")
}
